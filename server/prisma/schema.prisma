generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  firstname       String    @default("Ikke navngivet")
  lastname        String    @default("Ikke navngivet")
  email           String    @unique
  password        String
  description     String?   @db.Text
  refreshToken    String
  isActive        Boolean   @default(true)

  // BILLEDE (legacy + cloud)
  imageUrl        String?   @db.Text         
  cloudPublicId   String?   @unique
  cloudSecureUrl  String?

  bookings        Booking[]
  reviewsRecieved Review[]  @relation("reviewsRecieved")
  reviewsWritten  Review[]  @relation("reviewsWritten")
  trips           Trip[]

  @@map("users")
}

model Trip {
  id                 Int       @id @default(autoincrement())
  userId             Int
  departureDate      DateTime
  addressDeparture   String    @db.Text
  cityDeparture      String    @db.Text
  addressDestination String    @db.Text
  cityDestination    String    @db.Text
  routeDeviation     Int
  seatsTotal         Int
  pricePerSeat       Decimal   @db.Decimal(10, 2)
  bagSizeId          Int
  comment            String    @db.Text
  allowChildren      Boolean
  allowSmoking       Boolean
  allowMusic         Boolean
  allowPets          Boolean
  hasComfort         Boolean
  useFerry           Boolean
  isElectric         Boolean
  createdAt          DateTime  @default(now())

  bookings           Booking[]
  bagsize            Bagsize   @relation(fields: [bagSizeId], references: [id])
  user               User      @relation(fields: [userId], references: [id])

  @@index([bagSizeId], map: "trips_bagSizeId_fkey")
  @@index([userId], map: "trips_userId_fkey")
  @@map("trips")
}

model Booking {
  id        Int      @id @default(autoincrement())
  tripId    Int
  userId    Int
  comment   String   @db.Text
  numSeats  Int
  createdAt DateTime @default(now())

  trip      Trip     @relation(fields: [tripId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([tripId], map: "bookings_tripId_fkey")
  @@index([userId], map: "bookings_userId_fkey")
  @@map("bookings")
}

model Review {
  id              Int      @id @default(autoincrement())
  numStars        Int
  comment         String   @db.Text
  reviewerId      Int
  reviewedUserId  Int
  createdAt       DateTime @default(now())

  reviewsRecieved User     @relation("reviewsRecieved", fields: [reviewedUserId], references: [id])
  reviewer        User     @relation("reviewsWritten", fields: [reviewerId], references: [id])

  @@index([reviewedUserId], map: "reviews_reviewedUserId_fkey")
  @@index([reviewerId], map: "reviews_reviewerId_fkey")
  @@map("reviews")
}

model Bagsize {
  id             Int     @id @default(autoincrement())
  name           String
  description    String

  // IKON (legacy + cloud)
  iconUrl        String? @db.Text        
  cloudPublicId  String? @unique
  cloudSecureUrl String?

  trips          Trip[]

  @@map("bagsizes")
}

model Slide {
  id             Int     @id @default(autoincrement())
  text           String

  // BILLEDE (legacy + cloud)
  imageUrl       String? @db.Text        
  cloudPublicId  String? @unique
  cloudSecureUrl String?

  @@map("slides")
}

model Content {
  id      Int    @id @default(autoincrement())
  title   String
  content String @db.Text

  @@map("content")
}
